{
  "name": "e-vetdoc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "checkpoint": "bash scripts/checkpoint.sh",
    "db:generate": "npx supabase db diff -f",
    "db:migrate": "npx supabase db push",
    "db:setup": "npx supabase start",
    "db:types": "npx supabase gen types typescript --local > src/types/supabase.ts",
    "db:types:remote": "npx supabase gen types typescript --linked > src/types/supabase.ts",
    "setup": "npm run setup:env && npm run setup:ruflo && npm run setup:skills",
    "setup:env": "node -e \"const fs=require('fs');!fs.existsSync('.env.local')&&fs.copyFileSync('.env.example','.env.local');console.log('✅ .env.local ready');\"",
    "setup:ruflo": "npm install -g ruflo@latest && npx ruflo@latest init wizard",
    "setup:skills": "npx -y skills add https://github.com/Leonxlnx/taste-skill --all && npx -y skills add https://github.com/emilkowalski/skill --all && npx -y skills add https://github.com/pbakaus/impeccable --all && npx -y skills add anthropics/skills@claude-api -y && npx -y skills add shadcn/ui@shadcn -y && npx -y skills add alirezarezvani/claude-skills@a11y-audit -y && npx -y skills add coreyhaines31/marketingskills --all && npx -y skills add addyosmani/web-quality-skills@seo -y"
  },
